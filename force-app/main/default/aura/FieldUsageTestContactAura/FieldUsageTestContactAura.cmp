<aura:component implements="flexipage:availableForAllPageTypes,force:hasRecordId" access="global">
    <!-- Field Usage Intelligence test fixture.
         Explicit Contact.FirstName / Contact.LastName references are intentional so
         the Aura source scanner has deterministic object.field evidence to detect. -->
    <aura:attribute name="contact" type="Contact" default="{'sobjectType':'Contact'}" />
    <aura:attribute name="firstNameFieldReference" type="String" default="Contact.FirstName" />
    <aura:attribute name="lastNameFieldReference" type="String" default="Contact.LastName" />
    <lightning:input aura:id="firstName" label="Contact First Name" value="{!v.contact.FirstName}" />
    <lightning:input aura:id="lastName" label="Contact Last Name" value="{!v.contact.LastName}" />
</aura:component>
