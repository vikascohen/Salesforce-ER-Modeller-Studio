public with sharing class FieldUsageController {
    public class StatusDTO {
        @AuraEnabled public Field_Usage_Run__c run;
        @AuraEnabled public List<Field_Usage_Schedule__c> schedules;
        @AuraEnabled public Integer jobTotal;
        @AuraEnabled public Integer jobProcessed;
        @AuraEnabled public Integer jobErrors;
        @AuraEnabled public String jobStatus;
        @AuraEnabled public String jobType;
    }
    public class SnapshotDTO { @AuraEnabled public Boolean available; @AuraEnabled public Datetime completedAt; @AuraEnabled public Integer dependencyCount; }
    public class ScheduledJobDTO {
        @AuraEnabled public Id scheduleId; @AuraEnabled public String scheduleName; @AuraEnabled public Boolean enabled;
        @AuraEnabled public Decimal hour; @AuraEnabled public Decimal minute; @AuraEnabled public Id cronTriggerId;
        @AuraEnabled public String jobName; @AuraEnabled public String state; @AuraEnabled public Datetime nextFireTime;
        @AuraEnabled public Datetime previousFireTime; @AuraEnabled public String cronExpression;
    }
    @AuraEnabled public static SnapshotDTO getSnapshotAvailability(){
        SnapshotDTO dto=new SnapshotDTO(); List<Field_Usage_Run__c> rows=[SELECT Completed_At__c,Dependency_Count__c FROM Field_Usage_Run__c WHERE Is_Current__c=true AND Status__c='Completed' ORDER BY Completed_At__c DESC LIMIT 1];
        dto.available=!rows.isEmpty(); if(dto.available){dto.completedAt=rows[0].Completed_At__c;dto.dependencyCount=rows[0].Dependency_Count__c==null?0:rows[0].Dependency_Count__c.intValue();} return dto;
    }
    @AuraEnabled public static List<String> getSnapshotObjects(){
        List<String> names=new List<String>();
        for(AggregateResult row:[SELECT Object_API_Name__c objectName FROM Field_Usage_Evidence__c WHERE Run__r.Is_Current__c=true GROUP BY Object_API_Name__c ORDER BY Object_API_Name__c]){String objectName=(String)row.get('objectName');if(!String.isBlank(objectName))names.add(objectName);}
        return names.isEmpty()?getObjects():names;
    }
    @AuraEnabled(cacheable=true) public static List<String> getSnapshotFields(String objectApiName){return String.isBlank(objectApiName)?new List<String>():getFields(objectApiName);}
    @AuraEnabled(cacheable=true) public static List<String> getObjects(){List<String> names=new List<String>();Map<String,Schema.SObjectType> globalDescribe=Schema.getGlobalDescribe();for(String n:globalDescribe.keySet()){Schema.DescribeSObjectResult describe=globalDescribe.get(n).getDescribe();if(describe.isAccessible())names.add(describe.getName());}names.sort();return names;}
    @AuraEnabled(cacheable=true) public static List<String> getFields(String objectApiName){Schema.SObjectType t=Schema.getGlobalDescribe().get(objectApiName);if(t==null)throw new AuraHandledException('Unknown object.');List<String> names=new List<String>();for(Schema.SObjectField field:t.getDescribe().fields.getMap().values())names.add(field.getDescribe().getName());names.sort();return names;}
    public class EvidenceSummaryDTO { @AuraEnabled public String fieldApiName; @AuraEnabled public String sourceType; @AuraEnabled public Integer evidenceRows; @AuraEnabled public Decimal occurrences; }
    @AuraEnabled public static List<EvidenceSummaryDTO> getEvidenceSummary(String objectApiName,List<String> fieldApiNames){
        List<EvidenceSummaryDTO> out=new List<EvidenceSummaryDTO>();if(String.isBlank(objectApiName)||fieldApiNames==null||fieldApiNames.isEmpty())return out;Set<String> keys=new Set<String>();for(String f:fieldApiNames)if(!String.isBlank(f))keys.add(objectApiName+'.'+f);if(keys.isEmpty())return out;if(keys.size()>100)throw new AuraHandledException('Select no more than 100 fields at a time for Field Usage analysis.');Id currentRunId=getCurrentRunId();if(currentRunId==null)return out;
        for(AggregateResult row:[SELECT Field_API_Name__c fieldName,Source_Type__c sourceType,COUNT(Id) evidenceRows,SUM(Occurrence_Count__c) occurrences FROM Field_Usage_Evidence__c WHERE Run__c=:currentRunId AND Field_Key__c IN :keys GROUP BY Field_API_Name__c,Source_Type__c]){EvidenceSummaryDTO dto=new EvidenceSummaryDTO();dto.fieldApiName=(String)row.get('fieldName');dto.sourceType=(String)row.get('sourceType');dto.evidenceRows=(Integer)row.get('evidenceRows');Object total=row.get('occurrences');dto.occurrences=total==null?0:(Decimal)total;out.add(dto);}out.sort(new EvidenceSummaryComparator());return out;
    }
    private static Id getCurrentRunId(){List<Field_Usage_Run__c> runs=[SELECT Id FROM Field_Usage_Run__c WHERE Is_Current__c=true AND Status__c='Completed' ORDER BY Completed_At__c DESC LIMIT 1];return runs.isEmpty()?null:runs[0].Id;}
    public class EvidenceSummaryComparator implements Comparator<EvidenceSummaryDTO>{public Integer compare(EvidenceSummaryDTO a,EvidenceSummaryDTO b){String ak=(a.fieldApiName==null?'':a.fieldApiName)+'|'+(a.sourceType==null?'':a.sourceType);String bk=(b.fieldApiName==null?'':b.fieldApiName)+'|'+(b.sourceType==null?'':b.sourceType);return ak.compareTo(bk);}}
    @AuraEnabled public static List<Field_Usage_Evidence__c> getEvidence(String objectApiName,List<String> fieldApiNames){if(String.isBlank(objectApiName)||fieldApiNames==null||fieldApiNames.isEmpty())return new List<Field_Usage_Evidence__c>();Set<String> keys=new Set<String>();for(String f:fieldApiNames)keys.add(objectApiName+'.'+f);return [SELECT Field_Key__c,Object_API_Name__c,Field_API_Name__c,Source_Type__c,Component_Name__c,Component_Id__c,Evidence_Type__c,Confidence__c,Observed_At__c,Occurrence_Count__c,Location__c FROM Field_Usage_Evidence__c WHERE Run__r.Is_Current__c=true AND Field_Key__c IN :keys ORDER BY Field_API_Name__c,Source_Type__c,Component_Name__c LIMIT 5000];}
    public class EvidenceDetailDTO {@AuraEnabled public Id id;@AuraEnabled public String fieldApiName;@AuraEnabled public String sourceType;@AuraEnabled public String componentName;@AuraEnabled public String componentId;@AuraEnabled public String evidenceType;@AuraEnabled public Decimal occurrenceCount;@AuraEnabled public String location;@AuraEnabled public String evidence;}
    public class EvidenceDetailPageDTO {@AuraEnabled public List<EvidenceDetailDTO> rows;@AuraEnabled public Boolean hasMore;@AuraEnabled public Id nextCursor;}
    @AuraEnabled public static EvidenceDetailPageDTO getEvidenceDetail(String objectApiName,String fieldApiName,String sourceType,Integer rowLimit,Id afterId){EvidenceDetailPageDTO dto=new EvidenceDetailPageDTO();dto.rows=new List<EvidenceDetailDTO>();dto.hasMore=false;dto.nextCursor=null;if(String.isBlank(objectApiName)||String.isBlank(fieldApiName)||String.isBlank(sourceType))return dto;Integer lim=Math.max(1,Math.min(rowLimit==null?250:rowLimit,500));String key=objectApiName+'.'+fieldApiName;List<Field_Usage_Evidence__c> page;if(afterId==null)page=[SELECT Id,Field_API_Name__c,Source_Type__c,Component_Name__c,Component_Id__c,Evidence_Type__c,Occurrence_Count__c,Location__c,Evidence__c FROM Field_Usage_Evidence__c WHERE Run__r.Is_Current__c=true AND Field_Key__c=:key AND Source_Type__c=:sourceType ORDER BY Id LIMIT :lim+1];else page=[SELECT Id,Field_API_Name__c,Source_Type__c,Component_Name__c,Component_Id__c,Evidence_Type__c,Occurrence_Count__c,Location__c,Evidence__c FROM Field_Usage_Evidence__c WHERE Run__r.Is_Current__c=true AND Field_Key__c=:key AND Source_Type__c=:sourceType AND Id>:afterId ORDER BY Id LIMIT :lim+1];dto.hasMore=page.size()>lim;if(dto.hasMore)page.remove(page.size()-1);for(Field_Usage_Evidence__c row:page){EvidenceDetailDTO d=new EvidenceDetailDTO();d.id=row.Id;d.fieldApiName=row.Field_API_Name__c;d.sourceType=row.Source_Type__c;d.componentName=row.Component_Name__c;d.componentId=row.Component_Id__c;d.evidenceType=row.Evidence_Type__c;d.occurrenceCount=row.Occurrence_Count__c;d.location=row.Location__c;d.evidence=row.Evidence__c;dto.rows.add(d);}if(!page.isEmpty())dto.nextCursor=page[page.size()-1].Id;return dto;}
    @AuraEnabled public static List<Field_Usage_Evidence__c> searchEvidence(String searchText,String sourceType,Integer rowLimit){String raw=String.isBlank(searchText)?null:searchText.trim();Integer lim=Math.max(1,Math.min(rowLimit==null?250:rowLimit,500));String exactKey=raw!=null&&raw.contains('.')?raw:null;String prefix=raw==null?null:raw+'%';if(exactKey!=null&&!String.isBlank(sourceType))return [SELECT Field_Key__c,Object_API_Name__c,Field_API_Name__c,Source_Type__c,Component_Name__c,Component_Id__c,Evidence_Type__c,Confidence__c,Observed_At__c,Occurrence_Count__c,Location__c FROM Field_Usage_Evidence__c WHERE Run__r.Is_Current__c=true AND Source_Type__c=:sourceType AND Field_Key__c=:exactKey ORDER BY Object_API_Name__c,Field_API_Name__c,Source_Type__c,Component_Name__c LIMIT :lim];if(exactKey!=null)return [SELECT Field_Key__c,Object_API_Name__c,Field_API_Name__c,Source_Type__c,Component_Name__c,Component_Id__c,Evidence_Type__c,Confidence__c,Observed_At__c,Occurrence_Count__c,Location__c FROM Field_Usage_Evidence__c WHERE Run__r.Is_Current__c=true AND Field_Key__c=:exactKey ORDER BY Object_API_Name__c,Field_API_Name__c,Source_Type__c,Component_Name__c LIMIT :lim];if(prefix!=null&&!String.isBlank(sourceType))return [SELECT Field_Key__c,Object_API_Name__c,Field_API_Name__c,Source_Type__c,Component_Name__c,Component_Id__c,Evidence_Type__c,Confidence__c,Observed_At__c,Occurrence_Count__c,Location__c FROM Field_Usage_Evidence__c WHERE Run__r.Is_Current__c=true AND Source_Type__c=:sourceType AND (Field_Key__c LIKE :prefix OR Object_API_Name__c LIKE :prefix OR Field_API_Name__c LIKE :prefix OR Component_Name__c LIKE :prefix OR Location__c LIKE :prefix) ORDER BY Object_API_Name__c,Field_API_Name__c,Source_Type__c,Component_Name__c LIMIT :lim];if(prefix!=null)return [SELECT Field_Key__c,Object_API_Name__c,Field_API_Name__c,Source_Type__c,Component_Name__c,Component_Id__c,Evidence_Type__c,Confidence__c,Observed_At__c,Occurrence_Count__c,Location__c FROM Field_Usage_Evidence__c WHERE Run__r.Is_Current__c=true AND (Field_Key__c LIKE :prefix OR Object_API_Name__c LIKE :prefix OR Field_API_Name__c LIKE :prefix OR Component_Name__c LIKE :prefix OR Location__c LIKE :prefix) ORDER BY Object_API_Name__c,Field_API_Name__c,Source_Type__c,Component_Name__c LIMIT :lim];if(!String.isBlank(sourceType))return [SELECT Field_Key__c,Object_API_Name__c,Field_API_Name__c,Source_Type__c,Component_Name__c,Component_Id__c,Evidence_Type__c,Confidence__c,Observed_At__c,Occurrence_Count__c,Location__c FROM Field_Usage_Evidence__c WHERE Run__r.Is_Current__c=true AND Source_Type__c=:sourceType ORDER BY Object_API_Name__c,Field_API_Name__c,Source_Type__c,Component_Name__c LIMIT :lim];return [SELECT Field_Key__c,Object_API_Name__c,Field_API_Name__c,Source_Type__c,Component_Name__c,Component_Id__c,Evidence_Type__c,Confidence__c,Observed_At__c,Occurrence_Count__c,Location__c FROM Field_Usage_Evidence__c WHERE Run__r.Is_Current__c=true ORDER BY Object_API_Name__c,Field_API_Name__c,Source_Type__c,Component_Name__c LIMIT :lim];}
    @AuraEnabled(cacheable=true) public static List<String> getSourceTypes(){return new List<String>{'Apex Class','Apex Trigger','Flow','LWC','Aura','Validation Rule','Formula Field'};}
    @AuraEnabled(cacheable=true) public static List<Field_Usage_Run__c> getRecentRuns(Integer rowLimit){Integer lim=Math.max(1,Math.min(rowLimit==null?20:rowLimit,100));return [SELECT Id,Name,Status__c,Started_At__c,Completed_At__c,Dependency_Count__c,Error_Count__c,Is_Current__c,Progress_Percent__c,Progress_Phase__c,Objects_Total__c,Objects_Processed__c,Job_Id__c FROM Field_Usage_Run__c ORDER BY CreatedDate DESC LIMIT :lim];}
    @AuraEnabled public static Id runNow(){try{return FieldUsageOrchestrator.start('Manual');}catch(FieldUsageOrchestrator.ScanAlreadyRunningException ex){throw new AuraHandledException(ex.getMessage());}catch(FieldUsageToolingApiClient.ToolingApiException ex){throw new AuraHandledException(ex.getMessage());}}
    @AuraEnabled public static void bootstrap(){FieldUsageScheduleService.ensureDefaults();}
    @AuraEnabled public static StatusDTO getStatus(Id runId){StatusDTO dto=new StatusDTO();String fields='Id,Name,Status__c,Started_At__c,Completed_At__c,Heartbeat_At__c,Dependency_Count__c,Error_Count__c,Is_Current__c,Progress_Percent__c,Progress_Phase__c,Progress_Log__c,Objects_Total__c,Objects_Processed__c,Job_Id__c';if(runId!=null){List<Field_Usage_Run__c> exact=Database.query('SELECT '+fields+' FROM Field_Usage_Run__c WHERE Id=:runId LIMIT 1');dto.run=exact.isEmpty()?null:exact[0];}else{List<Field_Usage_Run__c> active=Database.query('SELECT '+fields+' FROM Field_Usage_Run__c WHERE Status__c IN (\'Queued\',\'Running\') ORDER BY CreatedDate DESC LIMIT 1');if(!active.isEmpty())dto.run=active[0];else{List<Field_Usage_Run__c> latest=Database.query('SELECT '+fields+' FROM Field_Usage_Run__c ORDER BY CreatedDate DESC LIMIT 1');dto.run=latest.isEmpty()?null:latest[0];}}populateJobStatus(dto);if(dto.run==null||String.isBlank(dto.jobStatus)||!new Set<String>{'Holding','Queued','Preparing','Processing'}.contains(dto.jobStatus)){Set<String> fieldUsageBatchClasses=new Set<String>{'FieldUsageDiscoveryBatch','FieldUsageToolingDiscoveryBatch','FieldUsageWorkUnitBatch'};List<AsyncApexJob> liveJobs=[SELECT Id,Status,JobType,TotalJobItems,JobItemsProcessed,NumberOfErrors,ExtendedStatus,ApexClass.Name,CreatedDate FROM AsyncApexJob WHERE ApexClass.Name IN :fieldUsageBatchClasses AND Status IN ('Holding','Queued','Preparing','Processing') ORDER BY CreatedDate DESC LIMIT 1];if(!liveJobs.isEmpty()){AsyncApexJob live=liveJobs[0];List<Field_Usage_Run__c> linked=Database.query('SELECT '+fields+' FROM Field_Usage_Run__c WHERE Job_Id__c=:live.Id ORDER BY CreatedDate DESC LIMIT 1');if(!linked.isEmpty())dto.run=linked[0];if(dto.run==null){dto.run=new Field_Usage_Run__c(Status__c='Running',Job_Id__c=String.valueOf(live.Id),Progress_Phase__c='Batch Apex job is '+live.Status);}else{dto.run.Status__c=live.Status=='Queued'||live.Status=='Holding'?'Queued':'Running';if(String.isBlank(dto.run.Progress_Phase__c))dto.run.Progress_Phase__c='Batch Apex job is '+live.Status;}copyJobStatus(dto,live);}}dto.schedules=[SELECT Id,Name,Enabled__c,Hour__c,Minute__c,Cron_Job_Name__c FROM Field_Usage_Schedule__c ORDER BY Hour__c,Minute__c];return dto;}
    private static void populateJobStatus(StatusDTO dto){if(dto==null||dto.run==null||String.isBlank(dto.run.Job_Id__c))return;try{Id asyncId=(Id)dto.run.Job_Id__c;List<AsyncApexJob> jobs=[SELECT Id,Status,JobType,TotalJobItems,JobItemsProcessed,NumberOfErrors,ExtendedStatus FROM AsyncApexJob WHERE Id=:asyncId LIMIT 1];if(!jobs.isEmpty()){copyJobStatus(dto,jobs[0]);if(new Set<String>{'Holding','Queued','Preparing','Processing'}.contains(jobs[0].Status)){dto.run.Status__c=jobs[0].Status=='Queued'||jobs[0].Status=='Holding'?'Queued':'Running';if(String.isBlank(dto.run.Progress_Phase__c))dto.run.Progress_Phase__c='Batch Apex job is '+jobs[0].Status;}}}catch(Exception ignored){}}
    private static void copyJobStatus(StatusDTO dto,AsyncApexJob job){dto.jobStatus=job.Status;dto.jobType=String.valueOf(job.JobType);dto.jobTotal=job.TotalJobItems;dto.jobProcessed=job.JobItemsProcessed;dto.jobErrors=job.NumberOfErrors;}
    @AuraEnabled public static void saveSchedules(List<Field_Usage_Schedule__c> rows){FieldUsageScheduleService.save(rows);}
    @AuraEnabled(cacheable=true) public static List<ScheduledJobDTO> getScheduledJobs(){String pattern=FieldUsageScheduleService.PREFIX+'%';Map<String,CronTrigger> jobsByName=new Map<String,CronTrigger>();for(CronTrigger job:[SELECT Id,State,NextFireTime,PreviousFireTime,CronExpression,CronJobDetail.Name FROM CronTrigger WHERE CronJobDetail.Name LIKE :pattern])jobsByName.put(job.CronJobDetail.Name,job);List<ScheduledJobDTO> out=new List<ScheduledJobDTO>();for(Field_Usage_Schedule__c row:[SELECT Id,Name,Enabled__c,Hour__c,Minute__c,Cron_Job_Name__c FROM Field_Usage_Schedule__c ORDER BY Hour__c,Minute__c]){ScheduledJobDTO dto=new ScheduledJobDTO();dto.scheduleId=row.Id;dto.scheduleName=row.Name;dto.enabled=row.Enabled__c;dto.hour=row.Hour__c;dto.minute=row.Minute__c;dto.jobName=row.Cron_Job_Name__c;CronTrigger job=String.isBlank(row.Cron_Job_Name__c)?null:jobsByName.get(row.Cron_Job_Name__c);if(job!=null){dto.cronTriggerId=job.Id;dto.state=job.State;dto.nextFireTime=job.NextFireTime;dto.previousFireTime=job.PreviousFireTime;dto.cronExpression=job.CronExpression;}else dto.state=row.Enabled__c?'Not Scheduled':'Paused';out.add(dto);}return out;}
    @AuraEnabled public static void pauseSchedule(Id scheduleId){FieldUsageScheduleService.setEnabled(scheduleId,false);}
    @AuraEnabled public static void resumeSchedule(Id scheduleId){FieldUsageScheduleService.setEnabled(scheduleId,true);}
    @AuraEnabled public static void deleteSchedule(Id scheduleId){if(scheduleId==null)return;delete [SELECT Id FROM Field_Usage_Schedule__c WHERE Id=:scheduleId LIMIT 1];FieldUsageScheduleService.apply();}
}