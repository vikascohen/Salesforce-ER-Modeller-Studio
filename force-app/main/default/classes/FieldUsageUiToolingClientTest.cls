/** Tests Tooling API UI metadata parsing without depending on live org UI metadata. @author Vikas Cohen */
@IsTest
private class FieldUsageUiToolingClientTest {
    private class UiMock implements HttpCalloutMock {
        public HttpResponse respond(HttpRequest request) {
            HttpResponse response=new HttpResponse();response.setStatusCode(200);String endpoint=request.getEndpoint();
            if(endpoint.contains('/composite')){System.assertEquals('POST',request.getMethod());System.assert(request.getBody().contains('ValidationRule'));response.setBody('{"compositeResponse":[{"httpStatusCode":200,"body":{"records":[{"Id":"03d000000000001","ValidationName":"Require_Name","Active":true,"EntityDefinition":{"QualifiedApiName":"Account"},"Metadata":{"errorConditionFormula":"ISBLANK(Name)"}}]}}]}');}
            else if(endpoint.contains('LightningComponentResource'))response.setBody('{"records":[{"Id":"0Rd1","FilePath":"account.js","Source":"Account.Name"}]}');
            else if(endpoint.contains('AuraDefinitionBundleId'))response.setBody('{"records":[{"Id":"0Ad1","DefType":"COMPONENT","Source":"Account.Name"}]}');
            else if(endpoint.contains('LightningComponentBundle'))response.setBody('{"records":[{"Id":"0Rb1","DeveloperName":"accountCard"}],"nextRecordsUrl":"/services/data/v60.0/tooling/query/next-lwc"}');
            else if(endpoint.contains('next-lwc'))response.setBody('{"records":[{"Id":"0Rb2","DeveloperName":"secondCard"}]}');
            else if(endpoint.contains('AuraDefinitionBundle'))response.setBody('{"records":[{"Id":"0Ab1","DeveloperName":"accountAura"}]}');
            else if(endpoint.contains('ValidationRule'))response.setBody('{"records":[{"Id":"03d000000000001","ValidationName":"Require_Name","Active":true,"EntityDefinition":{"QualifiedApiName":"Account"}}]}');
            else response.setBody('{"records":[]}');return response;
        }
    }
    @IsTest static void indexesResourcesRulesAndPaginationAreParsed(){Test.setMock(HttpCalloutMock.class,new UiMock());List<FieldUsageUiToolingClient.UiComponent> lwcIndex=FieldUsageUiToolingClient.getLwcBundleIndex();System.assertEquals(2,lwcIndex.size());System.assertEquals('accountCard',lwcIndex[0].name);List<FieldUsageUiToolingClient.UiComponent> auraIndex=FieldUsageUiToolingClient.getAuraBundleIndex();System.assertEquals(1,auraIndex.size());List<FieldUsageUiToolingClient.UiComponent> lwc=FieldUsageUiToolingClient.getLwcResources(new Set<String>{'0Rb1'});System.assertEquals(1,lwc.size());System.assertEquals('Unknown bundle / account.js',lwc[0].name);List<FieldUsageUiToolingClient.UiComponent> aura=FieldUsageUiToolingClient.getAuraResources(new Set<String>{'0Ab1'});System.assertEquals(1,aura.size());List<FieldUsageUiToolingClient.UiComponent> index=FieldUsageUiToolingClient.getValidationRuleIndex();System.assertEquals(1,index.size());System.assertEquals('Account',index[0].objectName);List<FieldUsageUiToolingClient.UiComponent> rules=FieldUsageUiToolingClient.getValidationRules(new Set<String>{'03d000000000001'});System.assertEquals(1,rules.size());System.assertEquals('ISBLANK(Name)',rules[0].body);System.assertEquals('Account',rules[0].objectName);System.assertEquals(0,FieldUsageUiToolingClient.getValidationRules(null).size());}
    private class LargeCompositeMock implements HttpCalloutMock {Integer compositeCalls=0;public HttpResponse respond(HttpRequest request){HttpResponse response=new HttpResponse();response.setStatusCode(200);if(request.getEndpoint().contains('/composite')){compositeCalls++;List<Object> replies=new List<Object>();Map<String,Object> sent=(Map<String,Object>)JSON.deserializeUntyped(request.getBody());for(Object ignored:(List<Object>)sent.get('compositeRequest'))replies.add(new Map<String,Object>{'httpStatusCode'=>200,'body'=>new Map<String,Object>{'records'=>new List<Object>{new Map<String,Object>{'Id'=>'03d'+compositeCalls+replies.size(),'ValidationName'=>'Rule'+replies.size(),'Active'=>true,'EntityDefinition'=>new Map<String,Object>{'QualifiedApiName'=>'Account'},'Metadata'=>new Map<String,Object>{'errorConditionFormula'=>'Name = null'}}}}});response.setBody(JSON.serialize(new Map<String,Object>{'compositeResponse'=>replies}));}else response.setBody('{"records":[]}');return response;}}
    @IsTest static void validationRulesAreChunkedAtCompositeLimit(){Set<String> ids=new Set<String>();for(Integer i=0;i<26;i++)ids.add('03d000000000'+String.valueOf(i).leftPad(3,'0'));LargeCompositeMock mock=new LargeCompositeMock();Test.setMock(HttpCalloutMock.class,mock);System.assertEquals(26,FieldUsageUiToolingClient.getValidationRules(ids).size());System.assertEquals(2,mock.compositeCalls);}
    private class IncompleteCompositeMock implements HttpCalloutMock {public HttpResponse respond(HttpRequest request){HttpResponse r=new HttpResponse();r.setStatusCode(200);r.setBody('{"compositeResponse":[{"httpStatusCode":404,"body":{"message":"deleted"}}]}');return r;}}
    @IsTest static void validationRuleSubrequestFailureIsNotSilent(){Test.setMock(HttpCalloutMock.class,new IncompleteCompositeMock());try{FieldUsageUiToolingClient.getValidationRules(new Set<String>{'03d000000000001'});System.assert(false,'Expected explicit subrequest failure');}catch(FieldUsageUiToolingClient.FieldUsageUiToolingException e){System.assert(e.getMessage().contains('retrieval incomplete'));System.assert(e.getMessage().contains('404'));}}
    private class MissingFormulaMock implements HttpCalloutMock {public HttpResponse respond(HttpRequest request){HttpResponse r=new HttpResponse();r.setStatusCode(200);r.setBody('{"compositeResponse":[{"httpStatusCode":200,"body":{"records":[{"Id":"03d1","ValidationName":"NoFormula","Active":true,"EntityDefinition":{"QualifiedApiName":"Contact"},"Metadata":{}}]}}]}');return r;}}
    @IsTest static void missingFormulaIsExplicit(){Test.setMock(HttpCalloutMock.class,new MissingFormulaMock());try{FieldUsageUiToolingClient.getValidationRules(new Set<String>{'03d1'});System.assert(false,'Expected missing formula failure');}catch(FieldUsageUiToolingClient.FieldUsageUiToolingException e){System.assert(e.getMessage().contains('No formula metadata'));}}
    private class ErrorMock implements HttpCalloutMock {public HttpResponse respond(HttpRequest request){HttpResponse r=new HttpResponse();r.setStatusCode(500);r.setBody('failure');return r;}}
    @IsTest static void errorsAreExplicitForQueryAndComposite(){Test.setMock(HttpCalloutMock.class,new ErrorMock());try{FieldUsageUiToolingClient.getLwcBundleIndex();System.assert(false);}catch(FieldUsageUiToolingClient.FieldUsageUiToolingException e){System.assert(e.getMessage().contains('HTTP 500'));}try{FieldUsageUiToolingClient.getValidationRules(new Set<String>{'03d1'});System.assert(false);}catch(FieldUsageUiToolingClient.FieldUsageUiToolingException e){System.assert(e.getMessage().contains('HTTP 500'));}}
}