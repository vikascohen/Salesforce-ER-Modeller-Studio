/** @author Vikas Cohen */
@IsTest
private class FieldUsageUiToolingClientTest {
 private class UiMock implements HttpCalloutMock {public HttpResponse respond(HttpRequest q){HttpResponse r=new HttpResponse();r.setStatusCode(200);String e=q.getEndpoint();if(e.contains('/composite')){r.setBody('{"compositeResponse":[{"httpStatusCode":200,"body":{"records":[{"Id":"03d000000000001","ValidationName":"Require_Name","Active":true,"EntityDefinition":{"QualifiedApiName":"Account"},"Metadata":{"errorConditionFormula":"ISBLANK(Name)"}}]}}]}');}else if(e.contains('LightningComponentResource'))r.setBody('{"records":[{"Id":"0Rd1","FilePath":"account.js","Source":"Account.Name","LightningComponentBundle":{"DeveloperName":"accountCard"}}]}');else if(e.contains('AuraDefinition'))r.setBody('{"records":[{"Id":"0Ad1","DefType":"COMPONENT","Source":"Account.Name","AuraDefinitionBundle":{"DeveloperName":"accountAura"}}]}');else if(e.contains('LightningComponentBundle'))r.setBody('{"records":[{"Id":"0Rb1","DeveloperName":"accountCard"}]}');else if(e.contains('AuraDefinitionBundle'))r.setBody('{"records":[{"Id":"0Ab1","DeveloperName":"accountAura"}]}');else if(e.contains('ValidationRule'))r.setBody('{"records":[{"Id":"03d000000000001","ValidationName":"Require_Name","Active":true,"EntityDefinition":{"QualifiedApiName":"Account"}}]}');else r.setBody('{"records":[]}');return r;}}
 @IsTest static void indexesResourcesAndRulesAreParsed(){Test.setMock(HttpCalloutMock.class,new UiMock());System.assertEquals(1,FieldUsageUiToolingClient.getLwcBundleIndex().size());System.assertEquals(1,FieldUsageUiToolingClient.getAuraBundleIndex().size());List<FieldUsageUiToolingClient.UiComponent> lwc=FieldUsageUiToolingClient.getLwcResources(new Set<String>{'0Rb1'});System.assertEquals(1,lwc.size());System.assert(lwc[0].name.contains('accountCard'));List<FieldUsageUiToolingClient.UiComponent> aura=FieldUsageUiToolingClient.getAuraResources(new Set<String>{'0Ab1'});System.assertEquals(1,aura.size());System.assertEquals(1,FieldUsageUiToolingClient.getValidationRuleIndex().size());List<FieldUsageUiToolingClient.UiComponent> rules=FieldUsageUiToolingClient.getValidationRules(new Set<String>{'03d000000000001'});System.assertEquals(1,rules.size());System.assertEquals('ISBLANK(Name)',rules[0].body);System.assertEquals('Account',rules[0].objectName);System.assertEquals(0,FieldUsageUiToolingClient.getLwcResources(new Set<String>()).size());System.assertEquals(0,FieldUsageUiToolingClient.getValidationRules(null).size());}
 private class ErrorMock implements HttpCalloutMock {public HttpResponse respond(HttpRequest q){HttpResponse r=new HttpResponse();r.setStatusCode(500);r.setBody('failure');return r;}}
 @IsTest static void errorsAreExplicit(){Test.setMock(HttpCalloutMock.class,new ErrorMock());try{FieldUsageUiToolingClient.getLwcBundleIndex();System.assert(false);}catch(FieldUsageUiToolingClient.FieldUsageUiToolingException e){System.assert(e.getMessage().contains('HTTP 500'));}try{FieldUsageUiToolingClient.getValidationRules(new Set<String>{'03d000000000001'});System.assert(false);}catch(FieldUsageUiToolingClient.FieldUsageUiToolingException e){System.assert(e.getMessage().contains('HTTP 500'));}}
}