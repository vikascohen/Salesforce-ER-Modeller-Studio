public without sharing class FieldUsageDiscoveryBatch implements Database.Batchable<String> {
 private final Id runId; public FieldUsageDiscoveryBatch(Id runId){this.runId=runId;}
 public Iterable<String> start(Database.BatchableContext bc){update new Field_Usage_Run__c(Id=runId,Status__c='Running',Started_At__c=System.now(),Heartbeat_At__c=System.now(),Progress_Percent__c=1,Progress_Phase__c='Discovering scan work');List<String> names=new List<String>(Schema.getGlobalDescribe().keySet());names.sort();return names;}
 public void execute(Database.BatchableContext bc,List<String> objectNames){Map<String,Schema.SObjectType> gd=Schema.getGlobalDescribe();List<Field_Usage_Work_Unit__c> units=new List<Field_Usage_Work_Unit__c>();for(String apiName:objectNames){Schema.SObjectType typ=gd.get(apiName);if(typ==null)continue;Schema.DescribeSObjectResult d=typ.getDescribe();if(!d.isAccessible()||!d.isQueryable())continue;for(String fieldName:d.fields.getMap().keySet()){Schema.DescribeFieldResult fd=d.fields.getMap().get(fieldName).getDescribe();if(fd.isCalculated()&&!String.isBlank(fd.getCalculatedFormula()))units.add(new Field_Usage_Work_Unit__c(Run__c=runId,Work_Key__c=String.valueOf(runId)+'|Formula|'+apiName+'|'+fieldName,Scanner_Type__c='Formula',Target_Key__c=apiName+'|'+fieldName,Status__c='Pending'));}}if(!units.isEmpty()){Database.SaveResult[] results=Database.insert(units,false);for(Database.SaveResult result:results)if(!result.isSuccess())throw new FieldUsageDiscoveryException('Could not checkpoint Formula discovery: '+result.getErrors()[0].getMessage());}update new Field_Usage_Run__c(Id=runId,Heartbeat_At__c=System.now(),Progress_Phase__c='Discovering scan work');}
 public void finish(Database.BatchableContext bc){AsyncApexJob job=[SELECT NumberOfErrors FROM AsyncApexJob WHERE Id=:bc.getJobId()];if(job.NumberOfErrors>0){FieldUsageSnapshotFinalizer.finish(runId,Integer.valueOf(job.NumberOfErrors),new List<String>{'Formula discovery batch reported platform errors.'});return;}Integer total=[SELECT COUNT() FROM Field_Usage_Work_Unit__c WHERE Run__c=:runId];update new Field_Usage_Run__c(Id=runId,Objects_Total__c=total,Progress_Percent__c=5,Progress_Phase__c='Queued formula work; discovering Tooling metadata');Id toolingDiscovery = Database.executeBatch(new FieldUsageToolingDiscoveryBatch(runId), 1); update new Field_Usage_Run__c(Id=runId, Job_Id__c=String.valueOf(toolingDiscovery), Progress_Phase__c='Discovering Apex classes, triggers and active Flows');}
 public class FieldUsageDiscoveryException extends Exception {}
}