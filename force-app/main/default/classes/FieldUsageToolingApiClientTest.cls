/** @author Vikas Cohen */
@IsTest
private class FieldUsageToolingApiClientTest {
 private class ToolingMock implements HttpCalloutMock { public HttpResponse respond(HttpRequest request){HttpResponse r=new HttpResponse();r.setStatusCode(200);Boolean body=request.getEndpoint().contains('Body');r.setBody('{"totalSize":2,"done":true,"records":[{"Id":"01p000000000001","Name":"AccountService"'+(body?',"Body":"String x = Account.Name;"':'')+'},{"Id":"01p000000000002","Name":"ContactService"'+(body?',"Body":"String x = Account.Name;"':'')+'}]}');return r;} }
 @IsTest static void indexQueryDoesNotRequestSourceBody(){Test.setMock(HttpCalloutMock.class,new ToolingMock());List<FieldUsageToolingApiClient.SourceComponent> c=FieldUsageToolingApiClient.getApexClassIndex();System.assertEquals(2,c.size());System.assertEquals(null,c[0].body);}
 @IsTest static void bulkSourceQueryReturnsMultipleComponentsInOneCall(){Test.setMock(HttpCalloutMock.class,new ToolingMock());Test.startTest();List<FieldUsageToolingApiClient.SourceComponent> c=FieldUsageToolingApiClient.getApexClasses(new Set<String>{'01p000000000001','01p000000000002'});Integer n=Limits.getCallouts();Test.stopTest();System.assertEquals(2,c.size());System.assertEquals('String x = Account.Name;',c[0].body);System.assertEquals(1,n);}
 private class EmptyMock implements HttpCalloutMock {public HttpResponse respond(HttpRequest q){HttpResponse r=new HttpResponse();r.setStatusCode(200);r.setBody('{"totalSize":0,"done":true,"records":[]}');return r;}}
 @IsTest static void deletedApexComponentIsHarmless(){Test.setMock(HttpCalloutMock.class,new EmptyMock());System.assertEquals(0,FieldUsageToolingApiClient.getApexClasses(new Set<String>{'01p000000000099'}).size());}
 private class DeletedFlowMock implements HttpCalloutMock {public HttpResponse respond(HttpRequest q){HttpResponse r=new HttpResponse();r.setStatusCode(404);r.setBody('[{"errorCode":"NOT_FOUND","message":"Flow was deleted"}]');return r;}}
 @IsTest static void deletedFlowBetweenDiscoveryAndWorkerIsHarmless(){Test.setMock(HttpCalloutMock.class,new DeletedFlowMock());System.assertEquals(0,FieldUsageToolingApiClient.scanFlow(null,'300000000000099').size());System.assertEquals(0,FieldUsageToolingApiClient.scanFlowVersions(null,new Set<String>{'301000000000099'}).size());}
 private class FlowMock implements HttpCalloutMock {public HttpResponse respond(HttpRequest q){HttpResponse r=new HttpResponse();r.setStatusCode(200);if(q.getEndpoint().contains('/tooling/sobjects/Flow/'))r.setBody('{"Id":"301000000000001","MasterLabel":"Account Flow","Metadata":{"object":"Account","field":"Name"}}');else r.setBody('{"totalSize":1,"done":true,"records":[{"Id":"300000000000001","DeveloperName":"Account_Flow","MasterLabel":"Account Flow","ActiveVersionId":"301000000000001"}]}');return r;}}
 @IsTest static void flowIndexAndMetadataAreParsed(){Test.setMock(HttpCalloutMock.class,new FlowMock());List<FieldUsageToolingApiClient.SourceComponent> index=FieldUsageToolingApiClient.getFlowIndex();System.assertEquals(1,index.size());System.assertEquals('301000000000001',index[0].id);List<Field_Usage_Evidence__c> evidence=FieldUsageToolingApiClient.scanFlow(null,'300000000000001');System.assertEquals(1,evidence.size());System.assertEquals('Account.Name',evidence[0].Field_Key__c);System.assertEquals(1,FieldUsageToolingApiClient.scanFlowVersions(null,new Set<String>{'301000000000001'}).size());FieldUsageToolingApiClient.FlowDiagnosticResult d=FieldUsageToolingApiClient.diagnoseFlow('300000000000001');System.assertEquals(true,d.success);}
 private class ErrorMock implements HttpCalloutMock {public HttpResponse respond(HttpRequest q){HttpResponse r=new HttpResponse();r.setStatusCode(500);r.setBody('server failure');return r;}}
 @IsTest static void connectionPreflightAcceptsAuthenticatedToolingApi(){Test.setMock(HttpCalloutMock.class,new EmptyMock());FieldUsageToolingApiClient.assertConnectionReady();}
 @IsTest static void connectionFailureIsExplicit(){Test.setMock(HttpCalloutMock.class,new ErrorMock());try{FieldUsageToolingApiClient.assertConnectionReady();System.assert(false);}catch(FieldUsageToolingApiClient.ToolingApiException e){System.assert(e.getMessage().contains('Salesforce_Tooling_API'));}try{FieldUsageToolingApiClient.getApexTriggerIndex();System.assert(false);}catch(FieldUsageToolingApiClient.ToolingApiException e){System.assert(e.getMessage().contains('HTTP 500'));}}
}